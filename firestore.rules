rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function validNotificationTime(value) {
      return value is string
             && value.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function validUserDocumentCreate() {
      return request.resource.data.keys().hasOnly([
               'displayName',
               'email',
               'createdAt',
               'aiEnabled',
               'timezone',
               'photoUrl',
               'notificationsEnabled',
               'notificationTime'
             ])
             && request.resource.data.keys().hasAll([
               'displayName',
               'email',
               'createdAt',
               'aiEnabled',
               'timezone',
               'notificationsEnabled',
               'notificationTime'
             ])
             && request.resource.data.displayName is string
             && request.resource.data.displayName.size() > 0
             && request.resource.data.email is string
             && request.resource.data.email.size() > 0
             && request.resource.data.createdAt is timestamp
             && request.resource.data.aiEnabled is bool
             && request.resource.data.timezone is string
             && request.resource.data.timezone.size() > 0
             && (!('photoUrl' in request.resource.data)
                 || request.resource.data.photoUrl == null
                 || request.resource.data.photoUrl is string)
             && request.resource.data.notificationsEnabled is bool
             && validNotificationTime(request.resource.data.notificationTime);
    }

    function validUserDocumentUpdate() {
      return request.resource.data.keys().hasOnly([
               'displayName',
               'email',
               'createdAt',
               'aiEnabled',
               'timezone',
               'photoUrl',
               'notificationsEnabled',
               'notificationTime'
             ])
             && request.resource.data.createdAt == resource.data.createdAt
             && request.resource.data.displayName is string
             && request.resource.data.displayName.size() > 0
             && request.resource.data.email is string
             && request.resource.data.email.size() > 0
             && request.resource.data.aiEnabled is bool
             && request.resource.data.timezone is string
             && request.resource.data.timezone.size() > 0
             && (!('photoUrl' in request.resource.data)
                 || request.resource.data.photoUrl == null
                 || request.resource.data.photoUrl is string)
             && request.resource.data.notificationsEnabled is bool
             && validNotificationTime(request.resource.data.notificationTime);
    }

    function validDreamBaseDocument(data) {
      return data.keys().hasOnly([
               'title',
               'text',
               'dreamDate',
               'createdAt',
               'updatedAt',
               'moodScore',
               'tags',
               'contextNotes',
               'aiCategory',
               'hasAudio',
               'audioPath',
               'transcription',
               'aiSummary'
             ])
             && data.title is string
             && data.title.size() > 0
             && data.text is string
             && data.text.size() > 0
             && data.dreamDate is timestamp
             && data.createdAt is timestamp
             && data.updatedAt is timestamp
             && (!('moodScore' in data)
                 || data.moodScore == null
                 || (data.moodScore is int
                     && data.moodScore >= 1
                     && data.moodScore <= 5))
             && (!('tags' in data)
                 || (data.tags is list && data.tags.size() <= 50))
             && (!('contextNotes' in data)
                 || data.contextNotes == null
                 || data.contextNotes is string)
             && (!('aiCategory' in data)
                 || data.aiCategory == null
                 || data.aiCategory is string)
             && data.hasAudio is bool
             && (!('audioPath' in data)
                 || data.audioPath == null
                 || data.audioPath is string)
             && (!('transcription' in data)
                 || data.transcription == null
                 || data.transcription is string)
             && (!('aiSummary' in data)
                 || data.aiSummary == null
                 || data.aiSummary is string);
    }

    function validDreamCreate() {
      return request.resource.data.keys().hasAll([
               'title',
               'text',
               'dreamDate',
               'createdAt',
               'updatedAt',
               'hasAudio'
             ])
             && validDreamBaseDocument(request.resource.data);
    }

    function validDreamUpdate() {
      return validDreamBaseDocument(request.resource.data)
             && request.resource.data.createdAt == resource.data.createdAt;
    }

    // Deny all access by default
    match /{document=**} {
      allow read, write: if false;
    }

    // User profile: only the owner can read/write
    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create: if isOwner(userId) && validUserDocumentCreate();
      allow update: if isOwner(userId) && validUserDocumentUpdate();

      // Dreams subcollection: only the owner can read/write
      match /dreams/{dreamId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && validDreamCreate();
        allow update: if isOwner(userId) && validDreamUpdate();
      }

      // Insights subcollection: only the owner can read; writes come from trusted backend (Functions)
      match /insights/{insightId} {
        allow read: if isOwner(userId);

        // Direct client writes require ownership + non-null required fields
        allow create, update: if isOwner(userId)
                               && request.resource.data.dreamId is string
                               && request.resource.data.dreamId.size() > 0
                               && request.resource.data.generatedAt != null;

        allow delete: if isOwner(userId);
      }
    }
  }
}
