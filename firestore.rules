rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function validNotificationTime(value) {
      return value is string
             && value.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function validUserDocumentCreate() {
      return request.resource.data.keys().hasAll([
               'displayName',
               'email',
               'createdAt',
               'aiEnabled',
               'timezone',
               'notificationsEnabled',
               'notificationTime'
             ])
             && request.resource.data.displayName is string
             && request.resource.data.displayName.size() > 0
             && request.resource.data.email is string
             && request.resource.data.email.size() > 0
             && request.resource.data.createdAt is timestamp
             && request.resource.data.aiEnabled is bool
             && request.resource.data.timezone is string
             && request.resource.data.timezone.size() > 0
             && (!('photoUrl' in request.resource.data)
                 || request.resource.data.photoUrl == null
                 || request.resource.data.photoUrl is string)
             && request.resource.data.notificationsEnabled is bool
             && validNotificationTime(request.resource.data.notificationTime);
    }

    function validUserDocumentUpdate() {
      return request.resource.data.createdAt == resource.data.createdAt
             && request.resource.data.email == resource.data.email
             && request.resource.data.displayName is string
             && request.resource.data.displayName.size() > 0
             && (!('dreamVisibility' in request.resource.data)
                 || request.resource.data.dreamVisibility in ['public', 'followers', 'private'])
             && (!('notificationTime' in request.resource.data)
                 || validNotificationTime(request.resource.data.notificationTime));
    }

    function validDreamBaseDocument(data) {
      return data.title is string
             && data.title.size() > 0
             && data.text is string
             && (data.text.size() > 0 || data.hasAudio == true)
             && data.dreamDate is timestamp
             && data.createdAt is timestamp
             && data.updatedAt is timestamp
             && (!('moodScore' in data)
                 || data.moodScore == null
                 || (data.moodScore is int
                     && data.moodScore >= 1
                     && data.moodScore <= 5))
             && (!('tags' in data)
                 || (data.tags is list && data.tags.size() <= 50))
             && (!('contextNotes' in data)
                 || data.contextNotes == null
                 || data.contextNotes is string)
             && (!('aiCategory' in data)
                 || data.aiCategory == null
                 || data.aiCategory is string)
             && data.hasAudio is bool
             && (!('audioPath' in data)
                 || data.audioPath == null
                 || data.audioPath is string)
             && (!('transcription' in data)
                 || data.transcription == null
                 || data.transcription is string)
             && (!('aiSummary' in data)
                 || data.aiSummary == null
                 || data.aiSummary is string);
    }

    function validDreamCreate() {
      return request.resource.data.keys().hasAll([
               'title',
               'text',
               'dreamDate',
               'createdAt',
               'updatedAt',
               'hasAudio'
             ])
             && validDreamBaseDocument(request.resource.data);
    }

    function validDreamUpdate() {
      return validDreamBaseDocument(request.resource.data)
             && request.resource.data.createdAt == resource.data.createdAt;
    }

    // Deny all access by default
    match /{document=**} {
      allow read, write: if false;
    }

    // User profile: owner has full access; any authenticated user can read (public profiles)
    match /users/{userId} {
      allow read: if isSignedIn();
      allow delete: if isOwner(userId);
      allow create: if isOwner(userId) && validUserDocumentCreate();
      allow update: if isOwner(userId) && validUserDocumentUpdate();

      // Dreams subcollection: only the owner can read/write
      match /dreams/{dreamId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && validDreamCreate();
        allow update: if isOwner(userId) && validDreamUpdate();
      }

      // Insights subcollection: only the owner can read; writes come from trusted backend (Functions)
      match /insights/{insightId} {
        allow read: if isOwner(userId);

        // Direct client writes require ownership + non-null required fields
        allow create, update: if isOwner(userId)
                               && request.resource.data.dreamId is string
                               && request.resource.data.dreamId.size() > 0
                               && request.resource.data.generatedAt != null;

        allow delete: if isOwner(userId);
      }
    }
    // ── Username reservations ─────────────────────────────────────────────────
    // Document ID is the lowercased displayName. Ensures uniqueness across users.
    match /usernames/{name} {
      // Public read: anyone can check if a name is taken (no sensitive data here)
      allow read: if true;
      // Only the uid owner of the reservation can create or delete it
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.displayName is string;
      allow delete: if isSignedIn()
                    && resource.data.uid == request.auth.uid;
    }
    // ── Social: follows ──────────────────────────────────────────────────────
    // Document ID format: "{followerId}_{followingId}"
    match /follows/{docId} {
      function isValidFollowCreateData() {
        return request.resource.data.keys().hasAll([
                 'followerId',
                 'followingId',
                 'createdAt'
               ])
               && request.resource.data.followerId is string
               && request.resource.data.followingId is string
               && request.resource.data.followerId.size() > 0
               && request.resource.data.followingId.size() > 0
               && request.resource.data.createdAt is timestamp
               && request.resource.data.followerId != request.resource.data.followingId
               && docId == request.resource.data.followerId + '_' + request.resource.data.followingId;
      }

      function canAcceptFromPendingRequest() {
        let followerId = request.resource.data.followerId;
        let followingId = request.resource.data.followingId;
        let reqPath = /databases/$(database)/documents/followRequests/$(followerId + '_' + followingId);

        return request.auth.uid == followingId
               && exists(reqPath)
               && get(reqPath).data.requesterId == followerId
               && get(reqPath).data.targetId == followingId
               && (!('status' in get(reqPath).data) || get(reqPath).data.status == 'pending');
      }

      // Any authenticated user can read follow relationships
      allow read: if isSignedIn();

      // Create allowed if:
      // 1) follower creates their own follow directly, OR
      // 2) target accepts an existing pending request from follower.
      allow create: if isSignedIn()
                    && isValidFollowCreateData()
                    && (
                      request.resource.data.followerId == request.auth.uid
                      || canAcceptFromPendingRequest()
                    );

        // Keep least privilege on delete (either side can remove relation)
      allow delete: if isSignedIn()
              && (resource.data.followerId == request.auth.uid
                || resource.data.followingId == request.auth.uid);
    }

    // ── Social: follow requests ───────────────────────────────────────────────
    // Document ID format: "{requesterId}_{targetId}"
    match /followRequests/{docId} {
      function isFollowRequestParticipantByFields() {
        return (resource.data.requesterId == request.auth.uid
                || resource.data.targetId == request.auth.uid
                || resource.data.senderId == request.auth.uid
                || resource.data.receiverId == request.auth.uid);
      }

      // Backward-compatible fallback for legacy docs that may miss participant
      // fields but still use the standard "{requesterId}_{targetId}" doc id.
      function isFollowRequestParticipantByDocId() {
        return docId.matches('^' + request.auth.uid + '_.*')
               || docId.matches('.*_' + request.auth.uid + '$');
      }

      // Individual document read: only the requester or the target can read
      allow get: if isSignedIn()
                 && (isFollowRequestParticipantByFields()
                     || isFollowRequestParticipantByDocId());
      // Collection queries (e.g. "where targetId == uid"): any signed-in user
      // resource.data is not available at query-evaluation time, so we allow
      // list for signed-in users and rely on client-side query constraints.
      allow list: if isSignedIn();
      // Only the requester can create a request for themselves
      allow create: if isSignedIn()
                    && request.resource.data.requesterId == request.auth.uid;
      // Either party can delete (requester cancels, target accepts/declines)
      allow delete: if isSignedIn()
              && (isFollowRequestParticipantByFields()
                || isFollowRequestParticipantByDocId());
    }

    // ── Social: public dreams ─────────────────────────────────────────────────
    match /publicDreams/{dreamId} {
      // Any authenticated user can read public dreams
      allow read: if isSignedIn();
      // Only the dream owner can create/update/delete the public dream doc
      allow create, update: if isSignedIn()
                             && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn()
                    && resource.data.userId == request.auth.uid;

      // Likes subcollection: document ID is the user's UID
      match /likes/{userId} {
        allow read: if isSignedIn();
        // Users can only manage their own like
        allow create, delete: if isSignedIn() && request.auth.uid == userId;
      }

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if isSignedIn();
        // Any authenticated user can add a comment
        allow create: if isSignedIn()
                      && request.resource.data.userId == request.auth.uid;
        // Only the comment author can delete their comment
        allow delete: if isSignedIn()
                      && resource.data.userId == request.auth.uid;
      }
    }
  }
}
